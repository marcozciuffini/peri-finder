{
  "expo": {
    "name": "PERi Finder",
    "slug": "peri-finder",
    "version": "1.0.34",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perifinder",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFF8F8",
      "translucent": false
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marcozciuffini.perifinder"
    },
    "android": {
      "splash": {
        "image": "./assets/images/nandos-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#F5EDD8",
        "dark": {
          "backgroundColor": "#000000"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#F5EDD8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "label": "PERi Finder",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.marcozciuffini.perifinder"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nandos-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F8",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
